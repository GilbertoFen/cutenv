PATCH http://localhost:3000/api/recipes/688bd36b464d2d8c2ea24bca
Content-Type: application/application/json

{
  "name": "Huevo con Jamon extra extra mucho ",
  "steps": "1. Estrela los huevos y revuelve junto con el jamon. 2.Frie todo junto con aceite.",
  "price": 45,
  "ingredients": [
    {
      "name": "Huevo",
      "quantity": 2,
      "unitMesure": "pieza"
    },
    {
      "name": "Jamon de pierna FUD",
      "quantity": 75,
      "unitMesure": "gr"
    }
  ]
}
