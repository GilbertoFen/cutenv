### Crear receta o platillo ( Aqui debe existir el id de los ingredientes 
### en la base de datos o regresa un error )
POST http://localhost:3000/api/recipes
Content-Type: application/json

{
  "name": "Ensalada Cesar",
  "steps": "1. Pica la lechuga. 2. Mezcla con el aderezo",
  "price": 60.5,
  "ingredients": [
    {
      "ingredientId": "6876f3358d6276645cde0105",  
      "quantity": 1,
      "unitMesure": "pieza"
    },
    {
      "ingredientId": "6876f3648d6276645cde0108",  
      "quantity": 50,
      "unitMesure": "ml"
    }
  ],
  "imageUrl": "https://res.cloudinary.com/dheg6jjxx/image/upload/v1754262386/ensalda-cesar_bfir6k.jpg"
}

