# Configuración de MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net
MONGODB_PATH=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/restaurant?retryWrites=true&w=majority
MONGODB_DB_NAME=restaurant
MONGODB_USERNAME=<usuario>
MONGODB_PASSWORD=<password>

# Credenciales iniciales para desarrollo y pruebas
POS_ROOT_USERNAME=root
POS_ROOT_PASSWORD=root
POS_MANAGER_USERNAME=gerente1
POS_MANAGER_PASSWORD=password123
POS_WORKER_USERNAME=mesero1
POS_WORKER_PASSWORD=password123

# Cloudinary (opcional para imágenes de platillos)
API_KEY_CLOUDINARY=
SECRET_KEY_CLOUDINARY=
CLOUD_NAME=

# Impresión automática de comanda en cocina (TRUE o FALSE)
TICKET_A_COCINA=TRUE
PRINTER_AGENT_URL=http://127.0.0.1:5001

# Facturación electrónica CFDI 4.0 (Fiscalisto)
FISCALISTO_API_KEY=fk_test_...
