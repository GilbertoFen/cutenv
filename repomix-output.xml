<file path="app/frontend/src/components/Manager/InventoryPanel.tsx">
import { useEffect, useMemo, useState } from "react";
import { getInventory, adjustStock } from "../../services/InventoryService";
import type { InventoryItem } from "../../types";
import { Kpi, Th, Td, fmtNum, currency } from "../../utils/Manager/manager.functions";

export default function InventoryPanel() {
  const [loading, setLoading] = useState(true);
  const [rows, setRows] = useState<InventoryItem[]>([]);
  const [q, setQ] = useState("");
  const [category, setCategory] = useState<string>("all");
  const [editing, setEditing] = useState<InventoryItem | null>(null);
  const [delta, setDelta] = useState<number>(0);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string>("");

  useEffect(() => {
    setLoading(true);
    getInventory().then(setRows).finally(() => setLoading(false));
  }, []);

  const categories = useMemo(() => {
    const set = new Set<string>();
    rows.forEach(r => r.category && set.add(r.category));
    return ["all", ...Array.from(set).sort((a, b) => a.localeCompare(b))];
  }, [rows]);

  const filtered = useMemo(() => {
    const text = q.trim().toLowerCase();
    return rows.filter(r => {
      if (category !== "all" && (r.category ?? "") !== category) return false;
      if (!text) return true;
      return [r.name, r.brand, r.sku, r.category, r.unit, r.description]
        .some(v => (v ?? "").toString().toLowerCase().includes(text));
    });
  }, [rows, q, category]);

  const kpis = useMemo(() => {
    const totalItems = rows.length;
    const totalStock = rows.reduce((acc, r) => acc + (Number.isFinite(r.currentQty) ? r.currentQty : 0), 0);
    return { totalItems, totalStock };
  }, [rows]);

  const quickAdjust = async (r: InventoryItem, d: number) => {
    try {
      setSaving(true);
      const target = await adjustStock(r, d);
      setRows(prev => prev.map(x => x.id === r.id ? { ...x, currentQty: target } : x));
    } catch (e: any) {
      alert(e?.message || "Error al ajustar stock");
    } finally {
      setSaving(false);
    }
  };

  const openModal = (r: InventoryItem) => {
    setEditing(r);
    setDelta(0);
    setError("");
  };

  const confirmAdjust = async () => {
    if (!editing) return;
    if (!Number.isFinite(delta) || delta === 0) {
      setError("Ingresa un número distinto de 0.");
      return;
    }
    try {
      setSaving(true);
      const target = await adjustStock(editing, delta);
      setRows(prev => prev.map(x => x.id === editing.id ? { ...x, currentQty: target } : x));
      setEditing(null);
    } catch (e: any) {
      setError(e?.message || "No se pudo guardar");
    } finally {
      setSaving(false);
    }
  };

  return (
    <section className="space-y-4">
      <h2 className="text-lg font-semibold">Inventario</h2>

      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <Kpi label="Ítems" value={String(kpis.totalItems)} />
        <Kpi label="Stock total (unidades)" value={String(kpis.totalStock)} />
      </div>

      {/* Filtros (sin exportar CSV) */}
      <div className="flex flex-wrap items-end gap-2">
        <div className="flex items-center gap-2">
          <label className="text-sm text-gray-600">Buscar</label>
          <input
            className="rounded-xl border px-3 py-2 text-sm"
            placeholder="Nombre, marca, SKU…"
            value={q} onChange={e => setQ(e.target.value)}
          />
        </div>
        <div className="flex items-center gap-2">
          <label className="text-sm text-gray-600">Categoría</label>
          <select
            className="rounded-xl border px-3 py-2 text-sm"
            value={category}
            onChange={e => setCategory(e.target.value)}
          >
            {categories.map(c => <option key={c} value={c}>{c === "all" ? "Todas" : c}</option>)}
          </select>
        </div>
      </div>

      {/* Tabla */}
      <div className="overflow-auto rounded-2xl border">
        <table className="min-w-full text-sm">
          <thead className="bg-gray-50 text-left">
            <tr>
              <Th>SKU</Th>
              <Th>Nombre</Th>
              <Th>Marca</Th>
              <Th>Categoría</Th>
              <Th>Unidad</Th>
              <Th className="text-right">Precio</Th>
              <Th className="text-right">Stock</Th>
              <Th>Acciones</Th>
              <Th>Actualizado</Th>
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr><td className="px-3 py-3 text-gray-500" colSpan={9}>Cargando…</td></tr>
            ) : filtered.length === 0 ? (
              <tr><td className="px-3 py-3 text-gray-500" colSpan={9}>Sin resultados.</td></tr>
            ) : filtered.map(r => (
              <tr key={r.id} className="border-t">
                <Td>{r.sku ?? "—"}</Td>
                <Td className="font-medium">{r.name}</Td>
                <Td>{r.brand ?? "—"}</Td>
                <Td>{r.category ?? "—"}</Td>
                <Td>{r.unit ?? "—"}</Td>
                <Td className="text-right">{r.price != null ? currency(r.price) : "—"}</Td>
                <Td className="text-right">{fmtNum(r.currentQty)}</Td>
                <Td>
                  <div className="flex flex-wrap gap-2">
                    <button
                      disabled={saving}
                      className="rounded-lg border px-2 py-1 text-xs hover:bg-gray-50"
                      onClick={() => quickAdjust(r, -1)}
                    >–1</button>
                    <button
                      disabled={saving}
                      className="rounded-lg border px-2 py-1 text-xs hover:bg-gray-50"
                      onClick={() => quickAdjust(r, +1)}
                    >+1</button>
                    <button
                      disabled={saving}
                      className="rounded-lg border px-2 py-1 text-xs hover:bg-gray-50"
                      onClick={() => quickAdjust(r, -5)}
                    >–5</button>
                    <button
                      disabled={saving}
                      className="rounded-lg border px-2 py-1 text-xs hover:bg-gray-50"
                      onClick={() => quickAdjust(r, +5)}
                    >+5</button>
                    <button
                      disabled={saving}
                      className="rounded-lg border px-2 py-1 text-xs hover:bg-gray-50"
                      onClick={() => openModal(r)}
                    >Ajuste…</button>
                  </div>
                </Td>
                <Td>{r.lastUpdate ? new Date(r.lastUpdate).toLocaleString() : "—"}</Td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {editing && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-3">
          <div className="w-full max-w-sm rounded-2xl bg-white shadow-xl">
            <header className="flex items-center justify-between border-b p-4">
              <h3 className="text-lg font-semibold">Ajustar stock</h3>
              <button className="rounded-lg border px-2 py-1 text-sm hover:bg-gray-50" onClick={() => setEditing(null)}>
                Cerrar
              </button>
            </header>
            <div className="p-4 space-y-3">
              <div className="text-sm">
                Producto: <span className="font-medium">{editing.name}</span>
              </div>
              <div className="text-sm">
                Stock actual: <span className="font-medium">{fmtNum(editing.currentQty)}</span>
              </div>
              <label className="block text-sm">
                Delta (+ agrega, – descuenta)
                <input
                  type="number"
                  className="mt-1 w-full rounded-xl border px-3 py-2 text-sm"
                  value={delta}
                  onChange={e => setDelta(Number(e.target.value))}
                />
              </label>
              {error && <div className="text-sm text-red-600">{error}</div>}
              <div className="flex justify-end gap-2 pt-2">
                <button className="rounded-lg border px-3 py-2 text-sm hover:bg-gray-50" onClick={() => setEditing(null)}>
                  Cancelar
                </button>
                <button
                  disabled={saving}
                  className="rounded-lg border px-3 py-2 text-sm hover:bg-gray-50"
                  onClick={confirmAdjust}
                >
                  Guardar
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </section>
  );
}
</file>

<file path="app/frontend/src/components/Manager/ReportsPanel.tsx">
import { useMemo, useState } from "react";
import type { SaleData } from "../../types";
import type { Props } from "../../types/Manager/manager.types";
import { Kpi, Th, Td, currency, dateFormat, num, safe } from "../../utils/Manager/manager.functions";
export default function ReportsPanel({ allSales, defaultDate }: Props) {
  const [from, setFrom] = useState<string>(() => defaultDate ?? dateFormat(new Date()));
  const [to, setTo] = useState<string>(() => defaultDate ?? dateFormat(new Date()));
  const [orderType, setOrderType] = useState<'all' | 'local' | 'para llevar' | 'evento' | 'domicilio'>('all');

  const setToday = () => {
    const d = new Date();
    const s = dateFormat(d);
    setFrom(s); setTo(s);
  };
  const setThisWeek = () => {
    const d = new Date();
    const dow = d.getDay();
    const start = new Date(d); start.setDate(d.getDate() - (dow === 0 ? 6 : dow - 1));
    const end = new Date(start); end.setDate(start.getDate() + 6);
    setFrom(dateFormat(start)); setTo(dateFormat(end));
  };
  const setThisMonth = () => {
    const d = new Date();
    const start = new Date(d.getFullYear(), d.getMonth(), 1);
    const end = new Date(d.getFullYear(), d.getMonth() + 1, 0);
    setFrom(dateFormat(start)); setTo(dateFormat(end));
  };

  const normalized = (t?: string) => (t ?? '').toLowerCase().trim();

  const saleHasType = (sale: SaleData, want: 'local' | 'para llevar' | 'evento' | 'domicilio') => {
    const w = normalized(want);
    if (normalized(sale.orderType) === w) return true;
    if (Array.isArray(sale.orders)) {
      return sale.orders.some(o => normalized(o?.orderType) === w);
    }
    return false;
  };

  const filtered = useMemo(() => {
    const start = new Date(from + "T00:00:00");
    const end = new Date(to + "T23:59:59");

    return (allSales || []).filter((s) => {
      if (!s?.date) return false;
      const dt = new Date(s.date);
      if (dt < start || dt > end) return false;

      if (orderType === "all") return true;
      return saleHasType(s, orderType);
    });
  }, [allSales, from, to, orderType]);

  const kpis = useMemo(() => {
    const count = filtered.length;
    const total = filtered.reduce((a, sale) => a + (sale.totalAmount || 0), 0);
    const avg = count ? total / count : 0;
    const paid = filtered.filter((s) => s.status === "paid").length;
    const open = filtered.filter((s) => s.status !== "paid").length;
    return { count, total, avg, paid, open };
  }, [filtered]);

  const byDay = useMemo(() => {
    const map: Record<string, { count: number; total: number }> = {};
    for (const s of filtered) {
      const key = s.date ? dateFormat(new Date(s.date)) : "—";
      if (!map[key]) map[key] = { count: 0, total: 0 };
      map[key].count += 1;
      map[key].total += (s.totalAmount || 0);
    }
    return Object.entries(map)
      .sort((a, b) => a[0].localeCompare(b[0]))
      .map(([date, v]) => ({ date, ...v, avg: v.count ? v.total / v.count : 0 }));
  }, [filtered]);

  const exportCSV = () => {
    const rows = [
      ["Fecha desde", from],
      ["Fecha hasta", to],
      [],
      ["KPIs"],
      ["Ventas", String(kpis.count)],
      ["Total", currency(kpis.total)],
      ["Ticket promedio", currency(kpis.avg)],
      ["Pagadas", String(kpis.paid)],
      ["Abiertas", String(kpis.open)],
      [],
      ["Detalle por día"],
      ["Fecha", "Ventas", "Total", "Promedio"],
      ...byDay.map(r => [r.date, String(r.count), num(r.total), num(r.avg)]),
    ];
    const csv = rows.map(r => r.map(safe).join(",")).join("\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `reporte_${from}_a_${to}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <section className="space-y-4">
      <h2 className="text-lg font-semibold">Resumen / Reportes</h2>

      {/* Controles */}
      <div className="flex flex-wrap items-end gap-2">
        <div className="flex items-center gap-2">
          <label className="text-sm text-gray-600">Desde</label>
          <input type="date" className="rounded-xl border px-3 py-2 text-sm" value={from} onChange={e => setFrom(e.target.value)} />
        </div>
        <div className="flex items-center gap-2">
          <label className="text-sm text-gray-600">Hasta</label>
          <input type="date" className="rounded-xl border px-3 py-2 text-sm" value={to} onChange={e => setTo(e.target.value)} />
        </div>

        <div className="ml-auto flex gap-2">
          <button className="rounded-xl border px-3 py-2 text-sm hover:bg-gray-50" onClick={setToday}>Hoy</button>
          <button className="rounded-xl border px-3 py-2 text-sm hover:bg-gray-50" onClick={setThisWeek}>Esta semana</button>
          <button className="rounded-xl border px-3 py-2 text-sm hover:bg-gray-50" onClick={setThisMonth}>Este mes</button>
          <button className="rounded-xl border px-3 py-2 text-sm hover:bg-gray-50" onClick={exportCSV}>Exportar CSV</button>
        </div>

        <div className="flex items-center gap-2">
          <label className="text-sm text-gray-600">Tipo de pedido</label>
          <select
            className="rounded-xl border px-3 py-2 text-sm"
            value={orderType}
            onChange={(e) => setOrderType(e.target.value as any)}
          >
            <option value="all">Todos</option>
            <option value="local">Local</option>
            <option value="para llevar">Para llevar</option>
            <option value="evento">Evento</option>
            <option value="domicilio">Domicilio</option>
          </select>
        </div>

      </div>

      {/* KPIs */}
      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
        <Kpi label="Ventas" value={String(kpis.count)} />
        <Kpi label="Total" value={currency(kpis.total)} />
        <Kpi label="Ticket promedio" value={currency(kpis.avg)} />
        <Kpi label="Pagadas" value={String(kpis.paid)} />
        <Kpi label="Abiertas" value={String(kpis.open)} />
      </div>

      {/* Tabla por día */}
      <div className="overflow-auto rounded-2xl border">
        <table className="min-w-full text-sm">
          <thead className="bg-gray-50 text-left">
            <tr>
              <Th>Fecha</Th>
              <Th>Ventas</Th>
              <Th>Total</Th>
              <Th>Promedio</Th>
            </tr>
          </thead>
          <tbody>
            {byDay.length === 0 ? (
              <tr><td className="px-3 py-3 text-gray-500" colSpan={4}>No hay datos en este rango.</td></tr>
            ) : byDay.map((r) => (
              <tr key={r.date} className="border-t">
                <Td>{r.date}</Td>
                <Td>{r.count}</Td>
                <Td>{currency(r.total)}</Td>
                <Td>{currency(r.avg)}</Td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  );
}
</file>

<file path="app/frontend/src/components/Manager/SaleDetailModal.tsx">
import { useEffect, useState } from "react";
import { getSaleById } from "../../services/SaleService";
import type { SaleData } from "../../types";
import { Th, Td, Kpi, currency } from "../../utils/Manager/manager.functions";
type Props = {
  saleId: string;
  onClose: () => void;
};

export default function SaleDetailModal({ saleId, onClose }: Props) {
  const [loading, setLoading] = useState(true);
  const [sale, setSale] = useState<SaleData | null>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    setLoading(true);
    getSaleById(saleId)
      .then((data) => setSale(data))
      .catch((e) => setError(e?.message || "Error al cargar la venta"))
      .finally(() => setLoading(false));
  }, [saleId]);

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-3">
      <div className="w-full max-w-2xl rounded-2xl bg-white shadow-xl">
        <header className="flex items-center justify-between border-b p-4">
          <h3 className="text-lg font-semibold">Detalle de venta</h3>
          <button className="rounded-lg border px-2 py-1 text-sm hover:bg-gray-50" onClick={onClose}>
            Cerrar
          </button>
        </header>

        <div className="max-h-[70vh] overflow-auto p-4">
          {loading && <div className="text-sm text-gray-500">Cargando…</div>}
          {error && <div className="text-sm text-red-600">{error}</div>}
          {!loading && sale && (
            <div className="space-y-4">
              {/* Encabezado */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <Kpi label="Folio" value={sale.folio ?? "—"} />
                <Kpi label="Fecha" value={sale.date ? new Date(sale.date).toLocaleString() : "—"} />
                <Kpi label="Estado" value={sale.status ?? "—"} />
                <Kpi label="Total" value={currency(sale.totalAmount || 0)} />
              </div>

              {/* Órdenes */}
              <section>
                <div className="mb-2 text-sm font-semibold">Órdenes</div>
                {(sale.orders && sale.orders.length > 0) ? (
                  <div className="space-y-3">
                    {sale.orders.map((o: any, idx: number) => (
                      <div key={o.id || o._id || idx} className="rounded-xl border p-3">
