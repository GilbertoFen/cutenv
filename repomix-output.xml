import { useState } from "react";
import type {Props} from '../../types/Receptionist/receptionist.types'
import { createReservation, localToUTCISO } from "../../services/ReservationService";

export default function ReservationModal({ table,tables, onClose, onCreated }: Props) {
  const [customerName, setCustomerName] = useState("");
  const [phone, setPhone] = useState("");
  const [partySize, setPartySize] = useState<number>(table?.capacity || 2);
  const [startLocal, setStartLocal] = useState<string>(() => {
    const d = new Date();
    d.setMinutes(Math.ceil(d.getMinutes() / 15) * 15, 0, 0);
    const iso = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    return iso; 
  });
  const [duration, setDuration] = useState<number>(120);
  const [notes, setNotes] = useState("");
  const [selectedTableId, setSelectedTableId] = useState<string>(table?.id ?? ""); // 👈
  const [saving, setSaving] = useState(false);
  const [err, setErr] = useState<string>("");

  const save = async () => {
    if (!startLocal) { setErr("Selecciona fecha y hora"); return; }
    if (!partySize || partySize < 1) { setErr("Número de personas inválido"); return; }
    setErr(""); setSaving(true);
    try {
      await createReservation({
        table: selectedTableId || undefined,  
        customerName,
        phone,
        partySize,
        startTime: localToUTCISO(startLocal),
        durationMinutes: duration,
        notes,
      });
      onCreated();
      onClose();
    } catch (e) {
      alert(e || "Error al crear la reservación");
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="fixed inset-0 bg-black/60 z-50 flex items-center justify-center">
      <div className="bg-white text-black rounded-xl p-4 w-full max-w-lg">
        <div className="flex justify-between items-center mb-3">
          <h3 className="text-lg font-bold">Reservar — Mesa {table?.number}</h3>
          <button onClick={onClose} className="text-xl font-bold">&times;</button>
        </div>

        <div className="grid grid-cols-1 gap-3 text-sm">
          {!table && (
            <label>
              <span className="block text-gray-700 mb-1">Mesa</span>
              <select
                className="w-full border rounded px-3 py-2"
                value={selectedTableId}
                onChange={(e) => setSelectedTableId(e.target.value)}
              >
                <option value="">— Selecciona una mesa —</option>
                {tables.map((t) => (
                  <option key={t.id} value={t.id}>
                    #{t.number} — {t.status} (cap: {t.capacity})
                  </option>
                ))}
              </select>
            </label>
          )}
          <label>
            <span className="block text-gray-700 mb-1">Nombre del cliente</span>
            <input className="w-full border rounded px-3 py-2"
                   value={customerName} onChange={e=>setCustomerName(e.target.value)} />
          </label>

          <label>
            <span className="block text-gray-700 mb-1">Teléfono</span>
            <input className="w-full border rounded px-3 py-2"
                   value={phone} onChange={e=>setPhone(e.target.value)} />
          </label>

          <div className="grid grid-cols-2 gap-3">
            <label>
              <span className="block text-gray-700 mb-1">Personas</span>
              <input type="number" min={1}
                     className="w-full border rounded px-3 py-2"
                     value={partySize} onChange={e=>setPartySize(Number(e.target.value))} />
            </label>
            <label>
              <span className="block text-gray-700 mb-1">Duración (min)</span>
              <input type="number" min={15} step={15}
                     className="w-full border rounded px-3 py-2"
                     value={duration} onChange={e=>setDuration(Number(e.target.value))} />
            </label>
          </div>

          <label>
            <span className="block text-gray-700 mb-1">Fecha y hora (local)</span>
            <input type="datetime-local"
                   className="w-full border rounded px-3 py-2"
                   value={startLocal} onChange={e=>setStartLocal(e.target.value)} />
          </label>

          <label>
            <span className="block text-gray-700 mb-1">Notas</span>
            <textarea className="w-full border rounded px-3 py-2 resize-none" rows={3}
                      value={notes} onChange={e=>setNotes(e.target.value)} />
          </label>

          {err && <div className="text-red-600">{err}</div>}
        </div>

        <div className="mt-4 flex justify-end gap-2">
          <button onClick={onClose} className="px-3 py-1 rounded border">Cancelar</button>
          <button disabled={saving} onClick={save}
                  className="px-3 py-1 rounded bg-[#14144f] text-white">
            {saving ? "Guardando..." : "Confirmar"}
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="app/frontend/src/components/Receptionist/ReservationDetailsModal.tsx">
import type { Reservation, Table } from "../../types";
import { seatReservation, cancelReservation, noShowReservation } from "../../services/ReservationService";
import { fmt } from "../../utils/Receptionist/receptionist.functions";
type Props = {
  reservation: Reservation;
  table: Table;
  onClose: () => void;
  onChanged: () => void;
};

export default function ReservationDetailsModal({ reservation, table, onClose, onChanged }: Props) {
  const seat = async () => {
    try {
      await seatReservation(reservation.id);
      onChanged();
      onClose();
    } catch (e) {
      alert(e || "Error al sentar");
    }
  };

  const cancel = async () => {
    if (!confirm("¿Cancelar esta reservación?")) return;
    try {
      await cancelReservation(reservation.id);
      onChanged();
      onClose();
    } catch (e) {
      alert(e || "Error al cancelar");
    }
  };

  return (
    <div className="fixed inset-0 bg-black/60 z-50 flex items-center justify-center">
      <div className="bg-white text-black rounded-xl p-4 w-full max-w-lg">
        <div className="flex justify-between items-center mb-3">
          <h3 className="text-lg font-bold">Reservación — Mesa {table.number}</h3>
          <button onClick={onClose} className="text-xl font-bold">&times;</button>
        </div>

        <div className="space-y-2 text-sm">
          <div><span className="text-gray-600">Cliente:</span> {reservation.customerName || "—"}</div>
          <div><span className="text-gray-600">Tel:</span> {reservation.phone || "—"}</div>
          <div><span className="text-gray-600">Personas:</span> {reservation.partySize ?? "—"}</div>
          <div><span className="text-gray-600">Inicio:</span> {fmt(reservation.startTime)}</div>
          <div><span className="text-gray-600">Fin:</span> {fmt(reservation.endTime)}</div>
          <div><span className="text-gray-600">Estado:</span> {reservation.status}</div>
          {reservation.notes && <div><span className="text-gray-600">Notas:</span> {reservation.notes}</div>}
        </div>

        <div className="mt-4 flex justify-end gap-2">
          {reservation.status === "programada" && (
            <>
              <button onClick={cancel} className="px-3 py-1 rounded border">Cancelar</button>
              <button onClick={seat} className="px-3 py-1 rounded bg-green-600 text-white">Ya llegó (Sentar)</button>
              <button onClick={async () => { await noShowReservation(reservation.id); onChanged(); onClose(); }}
                className="px-3 py-1 rounded border text-red-700">
                No asistió
              </button>
            </>
          )}

          {reservation.status === "sentada" && (
            <span className="text-sm text-green-700">Cliente sentado. Venta abierta.</span>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="app/frontend/src/components/Receptionist/TableCard.tsx">
import type { Table, Reservation } from "../../types";
import { updateTableStatus } from "../../services/TableService";
import { useEffect, useState } from "react";
import { getReservationInfoForTable } from "../../services/ReservationService";
import type { CardProps } from "../../types/Receptionist/receptionist.types";

import { dateFormat } from "../../utils/Receptionist/receptionist.functions";

export default function ReceptionistTableCard({ table, onChanged, onReserve, onViewReservation, resvVersion = 0 }: CardProps) {
  const [busy, setBusy] = useState(false);
  const [activeRes, setActiveRes] = useState<Reservation | null>(null);
  const [inLead, setInLead] = useState(false);
  const [mins, setMins] = useState<number | null>(null);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const info = await getReservationInfoForTable(table.id, dateFormat());
        if (!cancelled) {
          setActiveRes(info.reservation);
          setInLead(!!info.inLeadWindow);
          setMins(info.minutesToStart);
        }
      } catch {
        if (!cancelled) { setActiveRes(null); setInLead(false); setMins(null); }
      }
    })();
    return () => { cancelled = true; };
  }, [table.id, resvVersion]);

  const setStatus = async (status: Table["status"]) => {
    try {
      setBusy(true);
      await updateTableStatus(table.id, status);
      onChanged();
    } catch (e) {
      alert("No se pudo actualizar la mesa " + e);
    } finally {
      setBusy(false);
    }
  };

  const isOcupada = table.status === "ocupada";
  const canView =
    !!activeRes &&
    (
      activeRes.status === 'programada' ||
      (activeRes.status === 'sentada' && table.status !== 'disponible')
    );

  return (
    <div className="p-6 rounded-xl shadow border bg-white transition hover:shadow-md">
      <h2 className="text-xl font-bold text-center text-black">MESA {table.number}</h2>

      <div className={`font-bold text-center mt-2 ${isOcupada ? 'bg-[#646cffaa]' : 'border-2 border-[#646cffaa] bg-white'} rounded p-1`}>
        <p className="text-black text-sm">{table.status.toUpperCase()}</p>
      </div>

      {/* Badge con reserva del día */}
      {canView && (
        <div className="text-xs text-center mt-2 text-gray-700">
          {(activeRes.customerName || 'Reserva')} — {new Date(activeRes.startTime).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' })}
          {inLead && typeof mins === 'number' ? ` (bloquea en ~${Math.max(mins, 0)} min)` : ''}
        </div>
      )}

      <p className="text-center font-bold text-black text-sm mt-1">Capacidad: {table.capacity}</p>

      <div className="mt-2 flex flex-wrap gap-1 justify-center">
        {Array.from({ length: table.capacity }).map((_, i) => <span key={i} className="text-xl">👤</span>)}
      </div>


      <div className="mt-4 grid grid-cols-3 gap-2 text-black">
        <button disabled={busy} onClick={() => setStatus("disponible")} className="px-2 py-1 rounded border hover:bg-gray-50 text-sm">Disponible</button>
        <button disabled={busy || table.status === 'reservada'} onClick={() => setStatus("ocupada")} className="px-2 py-1 rounded border hover:bg-gray-50 text-sm">Ocupada</button>

        {!canView ? (
          <button
            disabled={busy || table.status !== "disponible"}
            onClick={() => onReserve(table)}
            className="px-2 py-1 rounded border hover:bg-gray-50 text-sm"
            title="Reservar"
          >
            Reservar
          </button>
        ) : (
          <button
            onClick={() => activeRes && onViewReservation(activeRes, table)}
            className="px-2 py-1 rounded border hover:bg-gray-50 text-sm"
            title="Ver reservación"
          >
            Ver reservación
          </button>
        )}
      </div>
    </div>
  );
}
</file>

<file path="app/frontend/src/components/Waiter/AddOrderModal.tsx">
import { useEffect, useState } from "react";
import { getAllRecipes } from "../../services/RecipeService";
import { createOrder } from "../../services/OrderService";
import type { Recipe } from "../../types";
import type { AddOrderModalProps, SelectedItem } from "../../types";

export default function AddOrderModal({
  tableId,
  onClose,
  onRefresh,
}: AddOrderModalProps) {
  const [recipes, setRecipes] = useState<Recipe[]>([]);
  const [selectedItems, setSelectedItems] = useState<SelectedItem[]>([]);
  const [activeCategory, setActiveCategory] = useState<string | null>(null);
  const [notes, setNotes] = useState("");

  useEffect(() => {
    getAllRecipes().then(setRecipes);
  }, []);

  const addItem = (recipe: Recipe) => {
    if (!recipe.id) {
      console.warn("No se encontro el id de la receta ", recipe);
      return;
    }
    setSelectedItems((prev) => {
      const i = prev.findIndex((x) => x.recipe.id === recipe.id);
      if (i !== -1) {
        const next = [...prev];
        next[i] = { ...next[i], quantity: next[i].quantity + 1 };
        return next;
      }
      return [...prev, { recipe, quantity: 1 }];
    });
  };

  const total = selectedItems.reduce(
    (sum, item) => sum + item.recipe.price * item.quantity,
    0
  );

  const sendOrder = async () => {
    const items = selectedItems.map((i) => ({
      recipe: i.recipe.id,
      quantity: i.quantity,
    }));
    await createOrder({ table: tableId, items, notes });
    onRefresh();
    onClose();
  };

  const filteredRecipes = activeCategory
    ? recipes.filter((r) => r.category === activeCategory)
    : recipes;

  const CategoryChip = ({
    value,
    label,
  }: {
    value: string | null;
    label: string;
  }) => {
    const active = activeCategory === value;
    return (
      <button
        onClick={() => setActiveCategory(value)}
        className={`px-3 py-2 rounded-full text-sm whitespace-nowrap transition
          ${active ? "bg-[#646cffaa] text-white font-bold" : "bg-gray-200 text-black"}
        `}
      >
        {label}
      </button>
    );
  };

  return (
    <div className="fixed inset-0 z-[1000] flex items-center justify-center">
      <div className="absolute inset-0 bg-black/60" onClick={onClose} />

      <div
        className="
          relative w-screen h-screen bg-white text-black
          md:w-[90vw] md:h-[90vh] md:max-w-5xl md:rounded-2xl md:shadow-2xl
          flex flex-col overflow-hidden
        "
      >
        <div className="sticky top-0 z-10 flex items-center justify-between border-b px-4 py-3 bg-white">
          <h2 className="text-lg md:text-xl font-bold">Menú</h2>
          <button
            onClick={onClose}
            className="rounded px-3 py-1 text-white bg-[#14144f] hover:opacity-90"
            aria-label="Cerrar"
            title="Cerrar"
          >
            ✕
          </button>
        </div>

        <div className="flex-1 overflow-y-auto">
          <div className="md:hidden border-b">
            <div className="px-4 pt-3 pb-2 text-sm font-semibold">Categorías</div>
            <div className="px-4 pb-3 flex gap-2 overflow-x-auto no-scrollbar">
              <CategoryChip value={"desayuno"} label="Desayuno" />
              <CategoryChip value={"bebidas"} label="Bebidas" />
              <CategoryChip value={null} label="Ver todo" />
            </div>
          </div>

          <div className="px-4 py-3 md:py-4 grid grid-cols-1 md:grid-cols-12 gap-0 md:gap-4 h-full">
            <aside className="hidden md:flex md:col-span-4">
              <div className="bg-gray-100 rounded-xl p-3 w-full flex flex-col min-h-0">
                <div className="shrink-0">
                  <h3 className="font-bold mb-2">Filtros / Categorías</h3>
                  <div className="flex flex-col gap-2">
                    <button
                      onClick={() => setActiveCategory("desayuno")}
                      className={`px-2 py-1 rounded w-full ${activeCategory === "desayuno"
                        ? "bg-[#646cffaa] font-bold text-white"
                        : "bg-gray-300"
                        }`}
                    >
                      Desayuno
                    </button>
                    <button
                      onClick={() => setActiveCategory("bebidas")}
                      className={`px-2 py-1 rounded w-full ${activeCategory === "bebidas"
                        ? "bg-[#646cffaa] font-bold text-white"
                        : "bg-gray-300"
                        }`}
                    >
                      Bebidas
                    </button>
                    <button
                      onClick={() => setActiveCategory(null)}
                      className={`px-2 py-1 rounded w-full ${activeCategory === null
                        ? "bg-[#646cffaa] font-bold text-white"
                        : "bg-gray-300"
